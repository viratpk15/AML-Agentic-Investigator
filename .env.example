# AML Investigation Copilot - Environment Settings
APP_NAME="AML Investigation Copilot"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DATA_DIR="data"

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# Primary provider: 'groq', 'gemini', or 'openai'
# Fallback providers: comma-separated list attempted in order on failure
# Example: LLM_FALLBACK_PROVIDERS="gemini,openai"
# ---------------------------------------------------------------------------
LLM_PROVIDER="groq"
LLM_FALLBACK_PROVIDERS="gemini"

# Shared generation parameters
LLM_TEMPERATURE=0.0
LLM_MAX_ITERATIONS=5
LLM_MAX_CONTEXT_TOKENS=5000

# ---------------------------------------------------------------------------
# Groq provider
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MAX_CONTEXT_TOKENS=5000

# ---------------------------------------------------------------------------
# Gemini provider (Google AI / Vertex AI)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MAX_CONTEXT_TOKENS=20000

# ---------------------------------------------------------------------------
# OpenAI provider (legacy / optional)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# OpenRouter provider (supports free models with tool calling)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_MAX_CONTEXT_TOKENS=12000
